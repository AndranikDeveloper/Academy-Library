# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

NODE_ENV=development

# Host/port the API server binds to.
PORT=4000
HOST=0.0.0.0

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:5173

# Logging verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://academy:academy@localhost:5432/academy_library?schema=public

# Signs the CSRF double-submit token (see src/middleware/csrf.ts) — not a
# password secret, just needs to be long and unpredictable. Generate your
# own with: openssl rand -hex 32
# Required — the server refuses to start without it.
CSRF_SECRET=changeme-generate-your-own-32-byte-hex-secret-with-openssl

# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME=academy_session

# How long a session stays valid after login, in hours. Fixed/absolute,
# not a sliding expiry — see docs/architecture/authentication.md.
SESSION_TTL_HOURS=720

# Optional overrides for `pnpm db:seed`'s three development accounts
# (student@academy.test / lecturer@academy.test / admin@academy.test).
# Each falls back to a documented, obviously-fake default
# ("DevPassword123!") if unset — see docs/architecture/authentication.md
# ("Development accounts"). Never set these to anything resembling a
# real credential; `pnpm db:seed` refuses to run at all when
# NODE_ENV=production regardless.
# SEED_STUDENT_PASSWORD=
# SEED_LECTURER_PASSWORD=
# SEED_ADMIN_PASSWORD=
